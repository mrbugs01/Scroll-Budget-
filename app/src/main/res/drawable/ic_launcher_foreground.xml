<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Small distant stars for a subtle space/futuristic feel -->
    <path android:pathData="M30,30 m-1.6,0 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.85" />
    <path android:pathData="M78,26 m-1.2,0 a1.2,1.2 0 1,1 2.4,0 a1.2,1.2 0 1,1 -2.4,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.7" />
    <path android:pathData="M70,40 m-1,0 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.6" />

    <!-- Orbit ring (drawn behind the planet) -->
    <path
        android:pathData="M22,60 A32,9 0 1,0 86,60 A32,9 0 1,0 22,60"
        android:strokeColor="#FFD166"
        android:strokeWidth="5"
        android:fillColor="#00000000" />

    <!-- A small moon riding the orbit -->
    <path android:pathData="M86,60 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0"
        android:fillColor="#FFD166" />

    <!-- The planet itself, drawn on top of the ring for a clean layered look -->
    <path android:pathData="M54,60 m-17,0 a17,17 0 1,1 34,0 a17,17 0 1,1 -34,0"
        android:fillColor="#FFFFFF" />

    <!-- Soft crescent shading on the planet for depth -->
    <path android:pathData="M62,50 a17,17 0 0,1 0,20 a13,10 0 0,0 0,-20"
        android:fillColor="#C9BFFF" android:fillAlpha="0.9" />

</vector>
