<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/brand_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/app_tagline"
            android:textColor="@color/brand_text_secondary"
            android:textSize="14sp" />

        <!-- Live Away-Streak Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_overlay_card"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/streakTierIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕐"
                android:textSize="52sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/streakTimerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/brand_text_primary"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/streakTierLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/streak_starting"
                android:textColor="@color/brand_text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Quick Setup (permission rows disappear automatically once granted) -->
        <LinearLayout
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_premium"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_heading"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/setupSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_instructions"
                android:textColor="@color/brand_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/permissionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- AI Coach -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_premium"
            android:layout_marginBottom="18dp">

            <ImageView
                android:id="@+id/robotMascot"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_robot_girl" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_coach_heading"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_coach_description"
                android:textColor="@color/brand_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/api_key_hint"
                android:inputType="textPassword"
                android:textColor="@color/brand_text_primary"
                android:textColorHint="@color/brand_text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_button_secondary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSaveApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/save_api_key"
                android:textColor="@color/brand_text_primary"
                android:textAllCaps="false"
                android:elevation="0dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAskAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_ai"
                android:text="@string/ask_ai_motivation"
                android:textColor="#0A0912"
                android:textAllCaps="false"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/aiResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/brand_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Reminders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_premium"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminders_heading"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reminders_description"
                android:textColor="@color/brand_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnOpenReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:text="@string/manage_reminders"
                android:textColor="@color/brand_text_primary"
                android:textAllCaps="false"
                android:elevation="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:textColor="@color/brand_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

        <!-- Books -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_premium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/books_heading"
                android:textColor="@color/brand_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:id="@+id/booksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
