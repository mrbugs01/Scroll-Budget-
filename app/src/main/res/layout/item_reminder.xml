<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_button_secondary"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="07:30 AM" />

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_text_secondary"
            android:textSize="13sp"
            tools:text="Study time" />

    </LinearLayout>

    <Button
        android:id="@+id/rowDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:text="🗑"
        android:textColor="@color/brand_error"
        android:textSize="20sp"
        android:elevation="0dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp" />

</LinearLayout>
